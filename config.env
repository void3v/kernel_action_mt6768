# Base section options
KERNEL_SOURCE=https://github.com/void3v/android_kernel_oneplus6
KERNEL_SOURCE_BRANCH=development
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz-dtb

# Compiler section options
USE_CLANG=true
CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/10.0.1-20220724-release/Clang-10.0.1-20220724.tar.gz
CLANG_BRANCH=
USE_GCC=false
USE_GCC_64=true
GCC_64_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/aarch64-linux-gnu/gcc-linaro-14.0.0-2023.06-x86_64_aarch64-linux-gnu.tar.xz
GCC_64_BRANCH=
USE_GCC_32=true
GCC_32_SOURCE=https://snapshots.linaro.org/gnu-toolchain/14.0-2023.06-1/arm-linux-gnueabihf/gcc-linaro-14.0.0-2023.06-x86_64_arm-linux-gnueabihf.tar.xz
GCC_32_BRANCH=

# Anykernel3 section options
USE_ANYKERNEL3=false
ANYKERNEL3_SOURCE=https://github.com/void3v/AnyKernel3.git
ANYKERNEL3_BRANCH=mt6768

# Build section options
EXTRA_CMDS=CLANG_TRIPLE=aarch64-linux-gnu- CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-
DISABLE_CC_WERROR=false
ENABLE_PYTHON2=false
ENABLE_CCACHE=false
REMOVE_UNUSED_PACKAGES=false
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# Proton specific section options
FIX_WIFI_SPEED=false
